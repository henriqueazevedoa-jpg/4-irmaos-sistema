# Copie este arquivo para ".env" e preencha os valores.
# Em desenvolvimento local, os valores abaixo já são os do Supabase local deste projeto.

# Banco de dados (PostgreSQL do Supabase)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:55322/postgres"

# Supabase (login e armazenamento de arquivos)
SUPABASE_URL="http://127.0.0.1:55321"
SUPABASE_ANON_KEY="cole-a-chave-publishable-aqui"
SUPABASE_SERVICE_KEY="cole-a-chave-secret-aqui"

# Servidor
PORT=3333
