# Variáveis para PRODUÇÃO (nuvem). Estes valores são preenchidos no painel do Render,
# não em um arquivo. Este arquivo é só uma referência do que preencher.
#
# Onde pegar (no painel do Supabase na nuvem → Project Settings → Database):

# Conexão do app — use o "Connection Pooler" (Transaction), porta 6543, e adicione ?pgbouncer=true
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta — usada só para aplicar as tabelas (migrações), porta 5432
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# Supabase (para login/arquivos no futuro) — em Project Settings → API
SUPABASE_URL="https://SEU_PROJETO.supabase.co"
SUPABASE_ANON_KEY="a-chave-publishable-do-supabase"
SUPABASE_SERVICE_KEY="a-chave-secret-do-supabase"

# NODE_ENV é definido como "production" automaticamente no render.yaml.
# A porta (PORT) é definida automaticamente pelo Render — não precisa configurar.
